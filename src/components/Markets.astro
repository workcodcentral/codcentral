---
const pillars = [
  {
    eyebrow: 'Who We Are',
    heading: 'One aim. One philosophy. One mission.',
    body: 'We are Codcentral Studios — a digital growth agency built with a single, uncompromising purpose: to <strong>STOP RANDOM MARKETING</strong>. Every strategy we build, every campaign we run, and every brand we touch is guided by intention, not guesswork.',
  },
  {
    eyebrow: 'What We Do',
    heading: 'We diagnose. We prescribe. We scale.',
    body: 'We diagnose and prescribe your brand with the best positioning to make sales — using technology, strategic positioning, and marketing that ensures your brand scales to your intended vision.',
  },
  {
    eyebrow: 'How We Do It',
    heading: 'Research. Position. Deliver.',
    body: 'We research the current market reality, apply the best technology and marketing to position your brand to your specific target audience — which in turn positions you for consistent online sales.',
  },
];
---

<section id="markets" class="section-pad bg-canvas">
  <div class="container-site">
    <div class="grid lg:grid-cols-2 gap-16 lg:gap-20 items-center">

      <!-- Left: content -->
      <div class="reveal space-y-10">
        <div>
          <span class="eyebrow mb-4">Our reach</span>
          <h2 class="font-display font-800 text-display-lg text-navy-500 text-balance mt-4">
            Built to stop<br/><span class="text-red-400">random marketing.</span>
          </h2>
        </div>

        <div class="space-y-8">
          {pillars.map((p) => (
            <div class="border-l-2 border-canvas-dark pl-5">
              <span class="font-body font-700 text-xs tracking-[0.15em] uppercase text-red-400 block mb-1">{p.eyebrow}</span>
              <h3 class="font-display font-700 text-lg text-navy-500 mb-2">{p.heading}</h3>
              <p class="font-body text-sm text-navy-400/70 leading-relaxed" set:html={p.body} />
            </div>
          ))}
        </div>

        <a
          href="/about"
          class="inline-flex items-center gap-2 font-body font-600 text-sm text-red-400 hover:text-red-500 transition-colors duration-200 group"
        >
          Read more about us
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-200 group-hover:translate-x-1"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>

      <!-- Right: image -->
      <div class="reveal" style="transition-delay:150ms">
        <div class="relative">
          <img
            src="/emmanuel.png"
            alt="Codcentral Studios team"
            class="w-full h-auto object-cover"
          />
          <!-- Floating badge -->
          <div class="absolute -bottom-5 -right-5 bg-white rounded-2xl shadow-lg border border-canvas-dark px-5 py-4 flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-red-400 flex items-center justify-center flex-shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>
            </div>
            <div>
              <div class="font-display font-800 text-navy-500 text-sm">Stop Random Marketing</div>
              <div class="font-body text-xs text-navy-400/60">Our founding philosophy</div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
