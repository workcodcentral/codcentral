---
const testimonials = [
  {
    quote: "Working with Codcentral Studios transformed how we communicate Hearts Foundation's mission online. Our donor enquiries increased by over 60% within two months. They don't just market — they understand your purpose and amplify it.",
    name: 'Adelaide Mwanza',
    title: 'Director, Hearts Foundation',
    image: '/adelaide.jpeg',
    initials: 'AM',
    color: 'bg-red-400',
  },
  {
    quote: "Codcentral helped us position Almalyq Motors to the right audience at exactly the right time. Our showroom walk-ins doubled and our online leads went from near zero to a consistent pipeline. Strategic, precise and results-driven.",
    name: 'Candy Dayo',
    title: 'Marketer, Almalyq Motors',
    image: '/almalyq.jpg',
    initials: 'CD',
    color: 'bg-sage-300',
  },
  {
    quote: "Before Codcentral, we were doing random marketing and wondering why it wasn't working. They diagnosed our brand, repositioned us and within 90 days Euphrates Centre had a waiting list for our programmes.",
    name: 'Beatrice Nafula',
    title: 'Director, Euphrates Centre',
    image: null,
    initials: 'BN',
    color: 'bg-navy-300',
  },
  {
    quote: "Codcentral Studios gave UGM a digital voice that actually resonates with our members and stakeholders. Our social engagement tripled and the quality of online enquiries improved dramatically. Truly professional work.",
    name: 'Susan Lumumba',
    title: 'UGM Party Secretary',
    image: '/suzzy.jpeg',
    initials: 'SL',
    color: 'bg-red-300',
  },
  {
    quote: "As a machinery business, I wasn't sure digital marketing would work for us. Codcentral proved me wrong — completely. They targeted the right farmers and agribusiness owners and our enquiries from online have never been higher.",
    name: 'Maurice Odinga',
    title: 'Director, Drfarm Machinery',
    image: '/maurice.jpeg',
    initials: 'MO',
    color: 'bg-sage-400',
  },
  {
    quote: "Grace Wangui brought Wicks Ecommerce to Codcentral at a critical growth stage. They rebuilt our entire digital strategy from the ground up — the results speak for themselves. Sales up 85% in one quarter.",
    name: 'Grace Wangui',
    title: 'Managing Director, Wicks Ecommerce',
    image: '/grace.jpeg',
    initials: 'GW',
    color: 'bg-red-400',
  },
];
---

<section id="clients" class="bg-navy-500 overflow-hidden py-20">
  <!-- Section header -->
  <div class="container-site mb-14 text-center reveal">
    <span class="eyebrow !text-white/50 before:bg-white/30 mb-4">Social proof</span>
    <h2 class="font-display font-800 text-display-lg text-white text-balance mt-4">
      What some of our<br/><span class="text-red-400">clients say</span>
    </h2>
  </div>

  <!-- Testimonial slider -->
  <div class="container-site" id="testimonial-slider">
    <div class="relative">
      <!-- Slides -->
      <div id="slider-track" class="overflow-hidden">
        <div id="slides-container" class="flex transition-transform duration-500 ease-in-out">
          {testimonials.map((t) => (
            <div class="slide min-w-full px-4 md:px-16">
              <div class="max-w-3xl mx-auto text-center">
                <!-- Stars -->
                <div class="flex justify-center gap-1 mb-7">
                  {[1,2,3,4,5].map(() => (
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="#E8382A" stroke="none"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                  ))}
                </div>

                <!-- Quote -->
                <blockquote class="font-display font-500 text-xl md:text-2xl text-white/90 leading-snug text-balance italic mb-10">
                  "{t.quote}"
                </blockquote>

                <!-- Attribution -->
                <div class="flex items-center justify-center gap-4">
                  {t.image ? (
                    <img
                      src={t.image}
                      alt={t.name}
                      class="w-12 h-12 rounded-full object-cover flex-shrink-0 border-2 border-white/20"
                    />
                  ) : (
                    <span class={`w-12 h-12 rounded-full ${t.color} flex items-center justify-center font-display font-700 text-sm text-white flex-shrink-0`}>
                      {t.initials}
                    </span>
                  )}
                  <div class="text-left">
                    <div class="font-display font-700 text-white text-sm">{t.name}</div>
                    <div class="font-body text-white/50 text-xs">{t.title}</div>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Arrow buttons -->
      <button id="prev-btn" class="absolute left-0 top-1/2 -translate-y-1/2 -translate-x-2 md:-translate-x-6 w-10 h-10 rounded-full border border-white/20 flex items-center justify-center text-white/60 hover:text-white hover:border-white/60 transition-all duration-200" aria-label="Previous testimonial">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      </button>
      <button id="next-btn" class="absolute right-0 top-1/2 -translate-y-1/2 translate-x-2 md:translate-x-6 w-10 h-10 rounded-full border border-white/20 flex items-center justify-center text-white/60 hover:text-white hover:border-white/60 transition-all duration-200" aria-label="Next testimonial">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
      </button>
    </div>

    <!-- Dots -->
    <div id="dots" class="flex justify-center items-center gap-2 mt-10">
      {testimonials.map((_, i) => (
        <button class={`dot ${i === 0 ? 'active' : ''}`} data-index={i} aria-label={`Go to testimonial ${i + 1}`}></button>
      ))}
    </div>
  </div>
</section>

<script>
  const container   = document.getElementById('slides-container')!;
  const dots        = document.querySelectorAll<HTMLElement>('#dots .dot');
  const totalSlides = document.querySelectorAll('.slide').length;
  let current = 0;
  let autoTimer: ReturnType<typeof setInterval>;

  const goTo = (idx: number) => {
    current = (idx + totalSlides) % totalSlides;
    container.style.transform = `translateX(-${current * 100}%)`;
    dots.forEach((d, i) => d.classList.toggle('active', i === current));
  };

  const startAuto = () => {
    autoTimer = setInterval(() => goTo(current + 1), 5000);
  };

  const resetAuto = () => {
    clearInterval(autoTimer);
    startAuto();
  };

  document.getElementById('prev-btn')!.addEventListener('click', () => { goTo(current - 1); resetAuto(); });
  document.getElementById('next-btn')!.addEventListener('click', () => { goTo(current + 1); resetAuto(); });
  dots.forEach((d) => d.addEventListener('click', () => { goTo(Number(d.dataset.index)); resetAuto(); }));

  startAuto();
</script>
