---
const tools = [
  { name: 'Meta Business Partner',  img: '/metabusinesspartnerlogo.jpg',      blend: false },
  { name: 'Google Ads',             img: '/googleadslogo.png',                blend: true  },
  { name: 'Google AdSense',         img: '/googleadsenselogo.jpg',            blend: false },
  { name: 'Google Search Console',  img: '/googlesearchconsolelogo.jpg',      blend: true  },
  { name: 'Notion',                 img: '/notionlogo.jpg',                   blend: false },
  { name: 'Co-operative Bank',      img: '/cooperativebanklogo.png',          blend: true  },
];
---

<section id="recognition" class="section-pad bg-white">
  <div class="container-site">
    <div class="reveal text-center max-w-xl mx-auto mb-16">
      <span class="eyebrow mb-4" data-cms-text="recognition_eyebrow">Recognition</span>
      <h2 class="font-display font-800 text-display-lg text-navy-500 text-balance">
        <span data-cms-text="recognition_title1">Recognised by the industry's</span><br/><span data-cms-text="recognition_title2">most rigorous judges</span>
      </h2>
    </div>

    <!-- Client rating CTA bar -->
    <div class="reveal rounded-2xl bg-navy-500 px-8 py-7 flex flex-col md:flex-row items-center justify-between gap-6 mb-12">
      <div class="flex items-center gap-6">
        <!-- Stars -->
        <div class="flex gap-1">
          {[1,2,3,4,5].map(() => (
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="#E8382A" stroke="none"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          ))}
        </div>
        <div>
          <div class="font-display font-800 text-3xl text-white" data-cms-text="rating_score">4.9 / 5.0</div>
          <div class="font-body text-xs text-white/50 mt-0.5" data-cms-text="rating_caption">Average client satisfaction across 39+ engagements</div>
        </div>
      </div>
      <div class="flex gap-4 items-center">
        <div class="text-center">
          <div class="font-display font-700 text-xl text-white" data-cms-text="retention_value">98%</div>
          <div class="font-body text-xs text-white/50" data-cms-text="retention_label">Client retention</div>
        </div>
        <div class="w-px h-10 bg-white/15"></div>
        <div class="text-center">
          <div class="font-display font-700 text-xl text-white" data-cms-text="referral_value">92%</div>
          <div class="font-body text-xs text-white/50" data-cms-text="referral_label">Referral rate</div>
        </div>
        <div class="w-px h-10 bg-white/15"></div>
        <a href="/contact" class="btn-primary text-xs px-5 py-2.5">Work with us</a>
      </div>
    </div>

    <!-- Tools & partners logos -->
    <div class="reveal flex flex-wrap items-center justify-center gap-x-12 gap-y-10 pt-4" data-cms-list="tools">
      {tools.map((t) => (
        <div class="flex flex-col items-center gap-2">
          <img
            src={t.img}
            data-cms-src="img"
            data-cms-alt="name"
            alt={t.name}
            class={`h-64 w-auto object-contain transition-all duration-300 ${t.blend ? 'mix-blend-multiply' : ''}`}
            loading="lazy"
          />
          <span class="font-body text-xs text-navy-400/50 text-center leading-tight" data-cms-text="name">{t.name}</span>
        </div>
      ))}
    </div>
  </div>
</section>
