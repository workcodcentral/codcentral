---
const cases = [
  {
    client: 'UGM',
    campaign: 'Party Awareness Campaign',
    tags: ['Social Media', 'Content Strategy', 'Community'],
    logo: '/ugm.jpg',
    color: 'bg-navy-400',
    challenge: 'The party had a great manifesto but had a problem penetrating the algorithm of social media. The message was not reaching the right people at the right volume.',
    approach: 'We combined the power of Trust, Volume and Direction when posting online, building a consistent content system that worked with the algorithm rather than against it.',
    duration: '6 months',
    outcomes: [
      { metric: '10x', label: 'Engagement growth' },
      { metric: '2x', label: 'Awareness doubled' },
      { metric: '6mo', label: 'Campaign duration' },
      { metric: '100%', label: 'Organic reach' },
    ],
    quote: 'Codcentral gave UGM a digital voice that actually resonates. Our social engagement tripled and the quality of online reach improved dramatically.',
    attribution: 'Susan Lumumba, UGM Party Secretary',
  },
  {
    client: 'Citychoice Real Estate',
    campaign: 'Brand Consistency Campaign',
    tags: ['Branding', 'Design Systems', 'Lead Nurturing'],
    logo: '/citychoice.png',
    color: 'bg-sage-400',
    challenge: 'Citychoice is a well-established company but struggled with brand consistency. Their look, tone and presence varied wildly across platforms.',
    approach: 'We developed full brand guidelines and templates then rebranded them consistently across every platform, making them unmistakably unique and memorable.',
    duration: '1 month',
    outcomes: [
      { metric: '+60%', label: 'Organic audience growth' },
      { metric: '+47%', label: 'Lead nurture growth' },
      { metric: '1mo', label: 'Time to results' },
      { metric: '100%', label: 'Brand consistency' },
    ],
    quote: 'Within one month of the rebrand, our organic audience grew 60% and our lead nurture pipeline improved by 47%. Exceptional work.',
    attribution: 'Citychoice Real Estate, Management',
  },
  {
    client: 'Almalyq Motors',
    campaign: 'Sales Pipeline Campaign',
    tags: ['Meta Ads', 'Lead Generation', 'Sales Automation'],
    logo: '/almalyq.jpg',
    color: 'bg-red-400',
    challenge: 'The car yard is in a prime physical location but struggled with qualified leads online. Most enquiries were tyre-kickers with no buying intent.',
    approach: 'We built an automated sales pipeline that qualifies incoming leads instantly, then ran two simultaneous Meta Ads campaigns targeting serious buyers only.',
    duration: '2 campaigns',
    outcomes: [
      { metric: '100', label: 'Qualified leads generated' },
      { metric: '-39%', label: 'Cost per lead reduction' },
      { metric: '2x', label: 'Simultaneous campaigns' },
      { metric: '0', label: 'Tyre-kickers passed through' },
    ],
    quote: 'Codcentral stopped the random marketing. The pipeline they built qualifies every lead automatically. Our sales team now only speaks to serious buyers.',
    attribution: 'Candy Dayo, Marketer, Almalyq Motors',
  },
  {
    client: "Claire's Organisation",
    campaign: 'Donor Acquisition Campaign',
    tags: ['Web Development', 'Branding', 'Donor Tracking'],
    logo: '/claires.png',
    color: 'bg-navy-300',
    challenge: "Claire's is a big NGO supporting 1,000 children but had zero online presence. No website, no donor tracking, and no way to reach funders digitally.",
    approach: 'We built a fast, mobile-optimised website and designed an emotional logo to build donor trust. We then ran 9 months of ongoing optimisation to grow their online presence.',
    duration: '9 months',
    outcomes: [
      { metric: '1,000', label: 'Children supported' },
      { metric: '9mo', label: 'Ongoing optimisation' },
      { metric: 'Major', label: 'Funding secured' },
      { metric: '1', label: 'New school block funded' },
    ],
    quote: 'After 9 months of working with Codcentral, we secured major funding to develop a new school block for our growing student population.',
    attribution: 'Adelaide Mwanza, Director, Hearts Foundation',
  },
  {
    client: 'Drfarm Machinery',
    campaign: 'Digital Sales System',
    tags: ['Web Development', 'SEO', 'Lead Generation'],
    logo: '/drfarm.png',
    color: 'bg-sage-300',
    challenge: 'Drfarm is in the top 3 machinery providers in Nairobi but had no online presence at all. Every sale came from physical walk-ins only.',
    approach: 'We built a fast, high-converting website that acts as their 24/7 digital sales employee, always online, always qualifying, always converting.',
    duration: '8 months',
    outcomes: [
      { metric: '159', label: 'Inquiries received' },
      { metric: '2x', label: 'Machine sales doubled' },
      { metric: '8mo', label: 'Campaign duration' },
      { metric: '24/7', label: 'Digital sales system' },
    ],
    quote: 'I had no online presence. Codcentral built us a system that works around the clock. In 8 months we received 159 inquiries and doubled our machine sales.',
    attribution: 'Maurice Odinga, Director, Drfarm Machinery',
  },
  {
    client: 'ShuleAi',
    campaign: 'User Acquisition Campaign',
    tags: ['EdTech', 'User Acquisition', 'Growth Marketing'],
    logo: null,
    color: 'bg-red-300',
    challenge: 'The edtech system is revolutionary but only 2 schools were using it for the first two years since production. The product was great but nobody knew about it.',
    approach: 'We built a targeted user acquisition system focused on school administrators and education decision-makers, running a 3-month campaign with precision targeting.',
    duration: '3 months',
    outcomes: [
      { metric: '290', label: 'App users acquired' },
      { metric: '100', label: 'Daily active visits' },
      { metric: '3mo', label: 'Campaign duration' },
      { metric: '145x', label: 'Growth from 2 schools' },
    ],
    quote: 'From 2 schools to 290 users with 100 daily visits in just 3 months. Codcentral built us a user acquisition machine.',
    attribution: 'ShuleAi, Founding Team',
  },
];
---

<section id="case-study" class="section-pad bg-canvas-dark">
  <div class="container-site">

    <!-- Header -->
    <div class="reveal max-w-2xl mb-16">
      <span class="eyebrow mb-4">Our work</span>
      <h2 class="font-display font-800 text-display-lg text-navy-500 text-balance">
        Real campaigns. Real results.<br/>No random marketing.
      </h2>
      <p class="mt-4 font-body text-base text-navy-400/70 leading-relaxed">
        Every engagement starts with a diagnosis. Every result is measured. Here is what intentional marketing looks like in practice.
      </p>
    </div>

    <!-- Case studies grid -->
    <div class="space-y-10">
      {cases.map((c, i) => (
        <div class="reveal rounded-3xl overflow-hidden bg-white border border-canvas-dark shadow-sm">
          <div class="grid lg:grid-cols-2 gap-0">

            <!-- Visual panel -->
            <div class={`bg-white relative min-h-[220px] flex flex-col items-center justify-center p-10 ${i % 2 !== 0 ? 'lg:order-2' : ''}`}>
              <div class="relative z-10 text-center">
                {c.logo ? (
                  <img src={c.logo} alt={c.client} class="w-32 h-32 object-contain mx-auto mb-5 drop-shadow-lg" />
                ) : (
                  <div class="w-24 h-24 rounded-2xl bg-canvas border border-canvas-dark flex items-center justify-center mb-5 mx-auto">
                    <span class="font-display font-800 text-3xl text-navy-500">{c.client[0]}</span>
                  </div>
                )}
                <div class="font-display font-800 text-2xl text-navy-500">{c.client}</div>
                <div class="font-body text-sm text-navy-400/60 mt-1">{c.campaign}</div>
                <div class="flex flex-wrap justify-center gap-2 mt-4">
                  {c.tags.map(tag => (
                    <span class="px-3 py-1 rounded-full bg-canvas border border-canvas-dark text-navy-500/70 font-body text-xs">{tag}</span>
                  ))}
                </div>
              </div>
            </div>

            <!-- Content panel -->
            <div class={`p-8 md:p-10 flex flex-col justify-between ${i % 2 !== 0 ? 'lg:order-1' : ''}`}>
              <!-- Outcomes grid -->
              <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-2 xl:grid-cols-4 gap-4 mb-8">
                {c.outcomes.map(o => (
                  <div class="bg-canvas rounded-xl p-3 text-center">
                    <div class="font-display font-800 text-xl text-navy-500 leading-none">{o.metric}</div>
                    <div class="font-body text-xs text-navy-400/60 mt-1 leading-tight">{o.label}</div>
                  </div>
                ))}
              </div>

              <!-- Challenge & approach -->
              <div class="space-y-4 mb-8">
                <div>
                  <div class="font-body font-700 text-xs uppercase tracking-widest text-red-400 mb-1">The Challenge</div>
                  <p class="font-body text-sm text-navy-400/70 leading-relaxed">{c.challenge}</p>
                </div>
                <div>
                  <div class="font-body font-700 text-xs uppercase tracking-widest text-red-400 mb-1">Our Approach</div>
                  <p class="font-body text-sm text-navy-400/70 leading-relaxed">{c.approach}</p>
                </div>
              </div>

              <!-- Quote -->
              <blockquote class="border-l-2 border-canvas-dark pl-4">
                <p class="font-body text-sm text-navy-500 italic leading-relaxed">"{c.quote}"</p>
                <footer class="mt-2 font-body text-xs text-navy-400/50">{c.attribution}</footer>
              </blockquote>
            </div>

          </div>
        </div>
      ))}
    </div>

    <!-- CTA -->
    <div class="reveal mt-16 text-center">
      <p class="font-body text-base text-navy-400/70 mb-6">Ready to add your story to this list?</p>
      <a href="/contact" class="btn-primary px-10 py-4">Start your campaign</a>
    </div>

  </div>
</section>
