---
const tabs = [
  {
    id: 'marketing',
    label: 'Marketing',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>`,
    headline: 'Growth marketing that compounds',
    sub: 'Full-funnel campaigns built to acquire, retain, and expand " across every channel that matters.',
    services: [
      { name: 'Performance Advertising', desc: 'Paid search, social, and programmatic managed for maximum ROAS.' },
      { name: 'SEO & Content Strategy', desc: 'Organic growth engines built on deep keyword and audience research.' },
      { name: 'Email & CRM Automation', desc: 'Lifecycle sequences that nurture leads from first touch to loyal customer.' },
      { name: 'Social Media & Community', desc: 'Platform-native content and community management that builds real audiences.' },
      { name: 'Influencer & Creator', desc: 'Vetted creator partnerships tied to measurable business outcomes.' },
      { name: 'Analytics & Attribution', desc: 'Single source of truth across all channels " no more data silos.' },
    ],
  },
  {
    id: 'technology',
    label: 'Technology',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>`,
    headline: 'Engineering for growth at scale',
    sub: 'From growth stack architecture to custom web experiences " we build the systems that power sustainable scale.',
    services: [
      { name: 'Web & App Development', desc: 'High-performance sites and web apps engineered for conversion.' },
      { name: 'Growth Stack Architecture', desc: 'CRM, analytics, and martech fully integrated and production-ready.' },
      { name: 'Conversion Rate Optimisation', desc: 'Continuous A/B testing and UX iteration backed by real data.' },
      { name: 'API & Integrations', desc: 'First and third-party data flowing cleanly across every tool.' },
      { name: 'AI & Automation', desc: 'Workflow automation and AI tooling that eliminate manual bottlenecks.' },
      { name: 'Platform Migrations', desc: 'Zero-downtime migrations with full data integrity guaranteed.' },
    ],
  },
  {
    id: 'design',
    label: 'Design',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8.56 2.75c4.37 6.03 6.02 9.42 8.03 17.72m2.54-15.38c-3.72 4.35-8.94 5.66-16.88 5.85m19.5 1.9c-3.5-.93-6.63-.82-8.94 0-2.58.92-5.01 2.86-7.44 6.32"/></svg>`,
    headline: 'Design that earns attention',
    sub: 'Brand identity, digital design, and creative production that makes your audience stop, feel, and act.',
    services: [
      { name: 'Brand Identity & Strategy', desc: 'Logos, guidelines, and verbal identity that command premium positioning.' },
      { name: 'UI/UX Design', desc: 'Research-backed interfaces that reduce friction and increase delight.' },
      { name: 'Campaign Creative', desc: 'Scroll-stopping creative across static, motion, and interactive formats.' },
      { name: 'Video & Motion', desc: 'Brand films, explainers, and social video from concept to delivery.' },
      { name: 'Packaging & Print', desc: 'Physical touchpoints designed to the same standard as digital ones.' },
      { name: 'Design Systems', desc: 'Scalable component libraries that keep your brand consistent at speed.' },
    ],
  },
];
---

<section id="services" class="section-pad bg-canvas">
  <div class="container-site">
    <!-- Header -->
    <div class="reveal max-w-2xl mb-14">
      <span class="eyebrow mb-4">What we do</span>
      <h2 class="font-display font-800 text-display-lg text-navy-500 text-balance">
        How we grow your brand
      </h2>
    </div>

    <!-- Tab buttons -->
    <div class="reveal flex gap-2 mb-10 flex-wrap" role="tablist" aria-label="Service disciplines">
      {tabs.map((tab, i) => (
        <button
          role="tab"
          aria-selected={i === 0 ? 'true' : 'false'}
          aria-controls={`panel-${tab.id}`}
          id={`tab-${tab.id}`}
          class={`tab-btn flex items-center gap-2 px-5 py-2.5 rounded-full font-body font-600 text-sm transition-all duration-200 border border-canvas-dark hover:border-navy-500 ${i === 0 ? 'active' : 'text-navy-400 bg-white'}`}
          data-tab={tab.id}
        >
          <span set:html={tab.icon} />
          {tab.label}
        </button>
      ))}
    </div>

    <!-- Tab panels -->
    {tabs.map((tab, i) => (
      <div
        id={`panel-${tab.id}`}
        role="tabpanel"
        aria-labelledby={`tab-${tab.id}`}
        class={`tab-panel ${i !== 0 ? 'hidden' : ''}`}
        data-panel={tab.id}
      >
        <!-- Panel intro -->
        <div class="mb-10 max-w-2xl">
          <h3 class="font-display font-700 text-display-sm text-navy-500 mb-3">{tab.headline}</h3>
          <p class="font-body text-base text-navy-400/70 leading-relaxed">{tab.sub}</p>
        </div>

        <!-- Service grid -->
        <div class="stagger grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {tab.services.map((s, j) => (
            <div class="card group cursor-default">
              <div class="flex items-start justify-between mb-4">
                <span class="font-body font-700 text-xs text-red-400 tracking-widest uppercase">0{j + 1}</span>
                <svg class="text-navy-100 group-hover:text-red-400 transition-colors duration-200" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </div>
              <h4 class="font-display font-700 text-base text-navy-500 mb-2">{s.name}</h4>
              <p class="font-body text-sm text-navy-400/65 leading-relaxed">{s.desc}</p>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<script>
  const buttons = document.querySelectorAll<HTMLElement>('.tab-btn');
  const panels  = document.querySelectorAll<HTMLElement>('.tab-panel');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.tab!;

      buttons.forEach((b) => {
        b.classList.remove('active');
        b.setAttribute('aria-selected', 'false');
        b.classList.add('text-navy-400', 'bg-white');
      });
      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');
      btn.classList.remove('text-navy-400', 'bg-white');

      panels.forEach((p) => {
        const isMatch = p.dataset.panel === target;
        p.classList.toggle('hidden', !isMatch);
      });
    });
  });
</script>
