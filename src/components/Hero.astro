---
const stats = [
  { value: '39',  suffix: '+', label: 'Brands Scaled' },
  { value: '100', suffix: 'M', label: 'Impressions Delivered' },
  { value: '14',  suffix: '+', label: 'Markets Reached' },
  { value: '56',  suffix: 'K', label: 'Leads Delivered' },
];
---

<section id="hero" class="relative min-h-screen flex flex-col justify-center overflow-hidden bg-navy-500">
  <!-- Background texture / gradient -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <!-- Warm radial glow top-right -->
    <div class="absolute -top-32 -right-32 w-[600px] h-[600px] rounded-full bg-red-400/10 blur-[120px]"></div>
    <!-- Sage glow bottom-left -->
    <div class="absolute -bottom-24 -left-24 w-[500px] h-[500px] rounded-full bg-sage-300/10 blur-[100px]"></div>
    <!-- Grid overlay -->
    <svg class="absolute inset-0 w-full h-full opacity-[0.04]" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="grid" width="48" height="48" patternUnits="userSpaceOnUse">
          <path d="M 48 0 L 0 0 0 48" fill="none" stroke="white" stroke-width="0.5"/>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#grid)"/>
    </svg>
  </div>

  <div class="container-site relative z-10 pt-28 pb-12 md:pt-36">
    <!-- Eyebrow -->
    <div class="reveal" style="transition-delay:80ms">
      <span class="eyebrow !text-white/60 before:bg-white/40">Global Digital Growth Partner</span>
    </div>

    <!-- Headline -->
    <h1 class="reveal mt-5 font-display font-800 text-display-2xl text-white leading-[1.04] tracking-[-0.03em] text-balance max-w-4xl" style="transition-delay:160ms">
      We scale brands<br/>
      <span class="text-red-400">that move</span> the world.
    </h1>

    <!-- Sub-headline -->
    <p class="reveal mt-6 font-body text-lg text-white/70 max-w-2xl leading-relaxed" style="transition-delay:240ms">
      Codcentral Studios is a full-service digital growth agency â€" fusing marketing strategy,
      technology engineering, and award-winning design to accelerate brands across every market.
    </p>

    <!-- CTAs -->
    <div class="reveal flex flex-wrap gap-4 mt-10" style="transition-delay:320ms">
      <a href="/contact" class="btn-primary text-sm px-8 py-4">
        Start Growing
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
      <a href="/work" class="btn-outline-white text-sm px-8 py-4">
        See Our Work
      </a>
    </div>

    <!-- Social proof line -->
    <p class="reveal mt-8 font-body text-sm text-white/50 flex items-center gap-3" style="transition-delay:400ms">
      <span class="flex -space-x-2">
        {['E','M','A','J','T'].map((l, i) => (
          <span class={`w-7 h-7 rounded-full border-2 border-navy-500 flex items-center justify-center text-xs font-700 text-white ${['bg-red-400','bg-sage-300','bg-navy-300','bg-red-300','bg-sage-400'][i]}`}>{l}</span>
        ))}
      </span>
      Trusted by 39+ brands worldwide
    </p>
  </div>

  <!-- Results strip -->
  <div class="relative z-10 mt-auto border-t border-white/10">
    <div class="container-site">
      <div class="grid grid-cols-2 md:grid-cols-4">
        {stats.map((s, i) => (
          <div
            class={`reveal py-7 px-4 text-center ${i < stats.length - 1 ? 'border-r border-white/10' : ''}`}
            style={`transition-delay:${i * 80}ms`}
          >
            <div class="font-display font-800 text-3xl md:text-4xl text-white">
              <span
                class="count-up"
                data-target={s.value}
                data-suffix={s.suffix}
                data-decimal={s.value.includes('.') ? 'true' : 'false'}
              >0{s.suffix}</span>
            </div>
            <div class="font-body text-xs text-white/50 mt-1 tracking-wide">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.count-up').forEach(el => {
    const target  = parseFloat(el.dataset.target!);
    const suffix  = el.dataset.suffix ?? '';
    const decimal = el.dataset.decimal === 'true';
    let started   = false;

    const run = () => {
      if (started) return;
      started = true;

      const duration = 2000;
      const startTime = performance.now();

      const tick = (now: number) => {
        const elapsed  = now - startTime;
        const progress = Math.min(elapsed / duration, 1);
        // ease-out cubic
        const eased    = 1 - Math.pow(1 - progress, 3);
        const current  = target * eased;

        el.textContent = (decimal ? current.toFixed(1) : Math.floor(current).toString()) + suffix;

        if (progress < 1) {
          requestAnimationFrame(tick);
        } else {
          el.textContent = (decimal ? target.toFixed(1) : target.toString()) + suffix;
        }
      };

      requestAnimationFrame(tick);
    };

    // Start as soon as the element is visible
    const obs = new IntersectionObserver(entries => {
      if (entries[0].isIntersecting) {
        run();
        obs.disconnect();
      }
    }, { threshold: 0.1 });

    obs.observe(el);
  });
</script>
