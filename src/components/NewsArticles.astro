<section id="news" class="section-pad bg-canvas" hidden>
  <div class="container-site">
    <div class="reveal flex flex-col sm:flex-row sm:items-end justify-between gap-6 mb-12">
      <div class="max-w-xl">
        <span class="eyebrow mb-4" data-cms-text="news_eyebrow">Fresh from the blog</span>
        <h2 class="font-display font-800 text-display-lg text-navy-500 text-balance">
          <span data-cms-text="news_title">Latest insights</span>
        </h2>
      </div>
      <a href="/insights" class="btn-secondary shrink-0 self-start sm:self-auto">
        All articles
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>

    <div class="stagger grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5" data-cms-list="latestArticles">
      <template data-cms-template>
        <article class="reveal group flex flex-col bg-white border border-canvas-dark hover:-translate-y-1 hover:shadow-md transition-all duration-200">
          <div class="h-1 w-full bg-red-400"></div>
          <div class="overflow-hidden h-40" data-cms-image hidden>
            <img
              data-cms-src="image"
              data-cms-alt="title"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
          </div>
          <div class="flex flex-col flex-1 p-5">
            <div class="flex items-center justify-between mb-3">
              <span class="font-body font-700 text-xs text-red-400 tracking-widest uppercase" data-cms-text="tag"></span>
              <span class="font-body text-xs text-navy-400/40" data-cms-text="readTime" data-cms-optional hidden></span>
            </div>
            <h3 class="font-display font-700 text-sm text-navy-500 leading-snug mb-2 line-clamp-3" data-cms-text="title"></h3>
            <p class="font-body text-xs text-navy-400/65 leading-relaxed flex-1 mb-4 line-clamp-3" data-cms-text="excerpt"></p>
            <div class="pt-4 border-t border-canvas-dark">
              <div class="flex items-center gap-2">
                <div>
                  <div class="font-body font-600 text-xs text-navy-500" data-cms-text="author"></div>
                  <div class="font-body text-xs text-navy-400/40" data-cms-text="date"></div>
                </div>
              </div>
            </div>
          </div>
        </article>
      </template>
    </div>
  </div>
</section>
