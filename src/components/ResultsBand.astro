---
const logos = [
  { src: '/almalyq.jpg',    alt: 'Almalyq' },
  { src: '/badili.png',     alt: 'Badili' },
  { src: '/citychoice.png', alt: 'City Choice' },
  { src: '/claires.png',    alt: "Claire's" },
  { src: '/drfarm.png',     alt: 'Dr Farm' },
  { src: '/euphrates.png',  alt: 'Euphrates' },
  { src: '/glorious.png',   alt: 'Glorious' },
  { src: '/ugm.jpg',        alt: 'UGM' },
];

---

<section id="trusted-by" class="py-14 bg-white border-y border-canvas-dark overflow-hidden">
  <div class="container-site mb-8 reveal">
    <p class="text-center font-body font-600 text-xs tracking-[0.2em] uppercase text-navy-400/50">
      <span data-cms-text="logos_heading">Trusted by brands that move the world</span>
    </p>
  </div>

  <!-- Carousel track -->
  <div class="relative">
    <!-- Left fade -->
    <div class="absolute left-0 top-0 bottom-0 w-24 z-10 pointer-events-none bg-gradient-to-r from-white to-transparent"></div>
    <!-- Right fade -->
    <div class="absolute right-0 top-0 bottom-0 w-24 z-10 pointer-events-none bg-gradient-to-l from-white to-transparent"></div>

    <div class="logos-track flex items-center gap-12 w-max" data-cms-list="logos">
      {logos.map((logo) => (
        <div class="flex-shrink-0 h-[72px] w-[166px] flex items-center justify-center grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition-all duration-300">
          <img
            src={logo.src}
            alt={logo.alt}
            data-cms-src="src"
            data-cms-alt="alt"
            class="max-h-[62px] max-w-[156px] w-auto h-auto object-contain"
            loading="lazy"
          />
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const track = document.querySelector<HTMLElement>('.logos-track');
  if (track) {
    const duplicateLogos = () => {
      const originals = [...track.children];
      track.replaceChildren(...originals, ...originals.map((logo) => logo.cloneNode(true)));
    };
    duplicateLogos();
    window.addEventListener('codcentral:cms-updated', duplicateLogos);
  }
</script>

<style>
  .logos-track {
    animation: marquee 28s linear infinite;
  }

  .logos-track:hover {
    animation-play-state: paused;
  }

  @keyframes marquee {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
</style>
