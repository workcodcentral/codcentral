---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<section id="brand-statement" class="py-24 bg-red-400 overflow-hidden relative">
  <div class="absolute -right-32 -top-32 w-96 h-96 rounded-full bg-red-300/30 pointer-events-none" aria-hidden="true"></div>
  <div class="absolute -left-24 -bottom-24 w-72 h-72 rounded-full bg-red-500/20 pointer-events-none" aria-hidden="true"></div>

  <div class="container-site relative z-10 text-center">
    <div class="reveal max-w-4xl mx-auto">
      <p class="font-display font-800 text-display-xl text-white leading-tight text-balance">
        Every brand has an unfair advantage waiting to be unlocked.
        <span class="italic font-500 text-white/80"> We find it, build it, and scale it.</span>
      </p>
      <div class="mt-10 flex flex-wrap gap-4 justify-center">
        <a href="/contact" class="btn-outline-white text-sm px-8 py-4">Start your growth journey</a>
        <a href="/work" class="inline-flex items-center gap-2 font-body font-600 text-sm text-white/70 hover:text-white transition-colors duration-200 py-4">
          See the results â†'
        </a>
      </div>
    </div>
  </div>
</section>
