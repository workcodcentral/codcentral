---
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = 'Codcentral Studios — Global Digital Growth Partner',
  description = 'We scale brands through marketing, technology and design. Your global digital growth partner.',
  ogImage = '/og-default.png',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/codcentrallogo.png" />

    <!-- Fonts preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <slot />

    <!-- WhatsApp floating widget -->
    <div id="wa-root" class="fixed bottom-6 right-6 z-50 flex flex-col items-end gap-3">

      <!-- CTA bubbles -->
      <div id="wa-ctas" class="flex flex-col items-end gap-2 pointer-events-none">
        <a href="https://wa.me/256754138667?text=Hi%2C%20I%27d%20like%20to%20get%20a%20free%20consultation!" target="_blank" rel="noopener noreferrer"
          class="wa-cta opacity-0 translate-y-4 pointer-events-auto flex items-center gap-2 bg-white text-navy-500 text-sm font-body font-600 px-4 py-2.5 rounded-2xl rounded-br-sm shadow-lg border border-canvas-dark transition-all duration-300 hover:bg-[#25D366] hover:text-white hover:border-[#25D366] whitespace-nowrap"
          style="transition-delay:0ms">
          💬 Get a free consultation
        </a>
        <a href="https://wa.me/256754138667?text=Hello%21%20I%27d%20love%20to%20see%20your%20portfolio%20and%20past%20work." target="_blank" rel="noopener noreferrer"
          class="wa-cta opacity-0 translate-y-4 pointer-events-auto flex items-center gap-2 bg-white text-navy-500 text-sm font-body font-600 px-4 py-2.5 rounded-2xl rounded-br-sm shadow-lg border border-canvas-dark transition-all duration-300 hover:bg-[#25D366] hover:text-white hover:border-[#25D366] whitespace-nowrap"
          style="transition-delay:150ms">
          🚀 See our work &amp; results
        </a>
        <a href="https://wa.me/256754138667?text=Hi%2C%20I%27d%20like%20to%20discuss%20pricing%20and%20packages." target="_blank" rel="noopener noreferrer"
          class="wa-cta opacity-0 translate-y-4 pointer-events-auto flex items-center gap-2 bg-white text-navy-500 text-sm font-body font-600 px-4 py-2.5 rounded-2xl rounded-br-sm shadow-lg border border-canvas-dark transition-all duration-300 hover:bg-[#25D366] hover:text-white hover:border-[#25D366] whitespace-nowrap"
          style="transition-delay:300ms">
          💰 Get pricing &amp; packages
        </a>
      </div>

      <!-- Main button -->
      <a
        href="https://wa.me/256754138667"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Chat with us on WhatsApp"
        id="whatsapp-widget"
        class="flex items-center gap-4 bg-[#25D366] text-white rounded-full shadow-lg px-5 py-4 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl group"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        <span class="max-w-0 overflow-hidden whitespace-nowrap font-body font-600 text-base transition-all duration-300 group-hover:max-w-xs">
          Chat with us
        </span>
      </a>
    </div>

    <script>
      // ---- Scroll-reveal observer ----
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('visible');
            }
          });
        },
        { threshold: 0.12 }
      );
      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));

      // ---- WhatsApp CTA auto-popup ----
      const ctas = document.querySelectorAll<HTMLElement>('.wa-cta');

      const showCTAs = () => {
        ctas.forEach((cta, i) => {
          setTimeout(() => {
            cta.style.transition = `opacity 0.4s ease ${i * 150}ms, transform 0.4s ease ${i * 150}ms`;
            cta.classList.remove('opacity-0', 'translate-y-4');
          }, 800 + i * 150);
        });
      };

      const hideCTAs = () => {
        ctas.forEach((cta) => {
          cta.classList.add('opacity-0', 'translate-y-4');
        });
      };

      // Show on load after a short delay
      showCTAs();

      // Auto-dismiss after 8 seconds
      setTimeout(hideCTAs, 8000);

      // Re-show if user clicks the main button area (wa-root) after dismissal
      document.getElementById('whatsapp-widget')?.addEventListener('mouseenter', showCTAs);
    </script>
  </body>
</html>
