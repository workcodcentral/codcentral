---
import PageLayout from '../../layouts/PageLayout.astro';
import Insights from '../../components/Insights.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<PageLayout
  title="Insights — Codcentral Studios"
  description="Strategy, technology and design thinking from the Codcentral Studios team. Fresh perspectives on digital growth."
>
  <section class="bg-navy-500 pt-36 pb-20 relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="absolute -top-32 -right-32 w-[500px] h-[500px] rounded-full bg-red-400/10 blur-[100px]"></div>
      <div class="absolute -bottom-16 -left-16 w-[400px] h-[400px] rounded-full bg-sage-300/10 blur-[80px]"></div>
    </div>
    <div class="container-site relative z-10">
      <div class="reveal max-w-3xl">
        <span class="eyebrow !text-white/50 before:bg-white/30 mb-5">Our thinking</span>
        <h1 class="mt-4 font-display font-800 text-display-xl text-white text-balance">
          Insights from<br/><span class="text-red-400">the front line.</span>
        </h1>
        <p class="mt-6 font-body text-lg text-white/65 leading-relaxed max-w-2xl">
          Real lessons from live campaigns, engineering projects, and brand transformations —
          written by the practitioners doing the work, not commentators watching from the sidelines.
        </p>
        <div class="mt-10 flex flex-wrap gap-4">
          <a href="/contact"  class="btn-primary">Work with us</a>
          <a href="/services" class="btn-outline-white">Our services</a>
        </div>
      </div>
    </div>
  </section>

  <Insights />
</PageLayout>
