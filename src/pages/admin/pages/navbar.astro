---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
const sbUrl = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
const sbKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '';
---
<DashboardLayout title="Page — Navbar" active="Navbar">

  <div class="page-header">
    <div><div class="page-title">Navbar</div><div class="page-sub">Manage navigation links and CTA button.</div></div>
    <button class="btn btn-primary" onclick="saveAll()">Save Changes</button>
  </div>

  <div style="display:grid;gap:16px">

    <div class="card card-pad">
      <div style="font-size:14px;font-weight:700;margin-bottom:16px;color:var(--text)">Navigation Links</div>
      <div id="links-wrap"></div>
      <button class="btn btn-secondary btn-sm" onclick="addLink()" style="margin-top:4px">+ Add Link</button>
    </div>

    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
      <div class="card card-pad">
        <div style="font-size:14px;font-weight:700;margin-bottom:16px;color:var(--text)">CTA Button</div>
        <div class="form-group"><label class="form-label">Label</label><input class="form-input" id="cta_label" /></div>
        <div class="form-group"><label class="form-label">URL</label><input class="form-input" id="cta_url" /></div>
      </div>
      <div class="card card-pad">
        <div style="font-size:14px;font-weight:700;margin-bottom:16px;color:var(--text)">Logo</div>
        <div class="form-group"><label class="form-label">Logo Image URL</label><input class="form-input" id="logo_url" /></div>
        <div class="form-group"><label class="form-label">Site name (alt text)</label><input class="form-input" id="logo_alt" /></div>
      </div>
    </div>

  </div>

  <script define:vars={{ sbUrl, sbKey }}>
    let links = [];

    (async () => {
      if (!sbUrl || sbUrl === 'your_supabase_project_url') return;
      const { createClient } = await import('https://esm.sh/@supabase/supabase-js@2');
      const sb = createClient(sbUrl, sbKey);

      const { data } = await sb.from('page_content').select('*').eq('page', 'navbar').maybeSingle();
      if (data?.content) {
        const c = data.content;
        links = c.links || [];
        document.getElementById('cta_label').value = c.cta_label || '';
        document.getElementById('cta_url').value   = c.cta_url   || '';
        document.getElementById('logo_url').value  = c.logo_url  || '';
        document.getElementById('logo_alt').value  = c.logo_alt  || '';
        renderLinks();
      }

      window.saveAll = async () => {
        const content = {
          links,
          cta_label: document.getElementById('cta_label').value,
          cta_url:   document.getElementById('cta_url').value,
          logo_url:  document.getElementById('logo_url').value,
          logo_alt:  document.getElementById('logo_alt').value,
        };
        await sb.from('page_content').upsert({ page: 'navbar', content }, { onConflict: 'page' });
        window.showToast('Navbar saved!');
      };
    })();

    function renderLinks() {
      document.getElementById('links-wrap').innerHTML = links.map((l, i) => `
        <div style="display:grid;grid-template-columns:1fr 1fr auto;gap:8px;margin-bottom:8px">
          <input class="form-input" value="${l.label || ''}" placeholder="Label" oninput="links[${i}].label=this.value" />
          <input class="form-input" value="${l.href  || ''}" placeholder="/path" oninput="links[${i}].href=this.value" />
          <button class="btn btn-danger btn-sm" onclick="removeLink(${i})">✕</button>
        </div>`).join('');
    }

    window.addLink    = () => { links.push({ label: '', href: '' }); renderLinks(); };
    window.removeLink = (i) => { links.splice(i, 1); renderLinks(); };
    if (!window.saveAll) window.saveAll = () => window.showToast('Configure Supabase in .env first.');
  </script>

</DashboardLayout>
