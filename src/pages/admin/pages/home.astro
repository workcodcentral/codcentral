---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
const sbUrl = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
const sbKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '';
---
<DashboardLayout title="Page — Home" active="Home">

  <div class="page-header">
    <div><div class="page-title">Home Page</div><div class="page-sub">Edit hero text, stats, and CTA content shown on the homepage.</div></div>
    <button class="btn btn-primary" onclick="saveAll()">Save Changes</button>
  </div>

  <div style="display:grid;gap:16px">

    <div class="card card-pad">
      <div style="font-size:14px;font-weight:700;margin-bottom:16px;color:var(--text)">Hero Section</div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
        <div class="form-group"><label class="form-label">Eyebrow label</label><input class="form-input" id="hero_eyebrow" /></div>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px">
        <div class="form-group"><label class="form-label">Headline line 1</label><input class="form-input" id="hero_line1" /></div>
        <div class="form-group"><label class="form-label">Headline line 2</label><input class="form-input" id="hero_line2" /></div>
        <div class="form-group"><label class="form-label">Headline line 3</label><input class="form-input" id="hero_line3" /></div>
      </div>
      <div class="form-group"><label class="form-label">Sub-headline</label><textarea class="form-textarea" id="hero_sub"></textarea></div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
        <div class="form-group"><label class="form-label">CTA 1 Label</label><input class="form-input" id="hero_cta1_label" /></div>
        <div class="form-group"><label class="form-label">CTA 1 URL</label><input class="form-input" id="hero_cta1_url" /></div>
        <div class="form-group"><label class="form-label">CTA 2 Label</label><input class="form-input" id="hero_cta2_label" /></div>
        <div class="form-group"><label class="form-label">CTA 2 URL</label><input class="form-input" id="hero_cta2_url" /></div>
      </div>
    </div>

    <div class="card card-pad">
      <div style="font-size:14px;font-weight:700;margin-bottom:16px;color:var(--text)">Hero Stats</div>
      <div id="stats-wrap"></div>
      <button class="btn btn-secondary btn-sm" onclick="addStat()" style="margin-top:4px">+ Add Stat</button>
    </div>

    <div class="card card-pad">
      <div style="font-size:14px;font-weight:700;margin-bottom:16px;color:var(--text)">Brand Statement Banner</div>
      <div class="form-group"><label class="form-label">Headline</label><input class="form-input" id="brand_headline" /></div>
      <div class="form-group"><label class="form-label">Sub-text</label><textarea class="form-textarea" id="brand_sub"></textarea></div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
        <div class="form-group"><label class="form-label">CTA 1 Label</label><input class="form-input" id="brand_cta1" /></div>
        <div class="form-group"><label class="form-label">CTA 1 URL</label><input class="form-input" id="brand_cta1_url" /></div>
        <div class="form-group"><label class="form-label">CTA 2 Label</label><input class="form-input" id="brand_cta2" /></div>
        <div class="form-group"><label class="form-label">CTA 2 URL</label><input class="form-input" id="brand_cta2_url" /></div>
      </div>
    </div>

  </div>

  <script define:vars={{ sbUrl, sbKey }}>
    let statsData = [];

    (async () => {
      if (!sbUrl || sbUrl === 'your_supabase_project_url') return;
      const { createClient } = await import('https://esm.sh/@supabase/supabase-js@2');
      const sb = createClient(sbUrl, sbKey);

      const { data, error: loadError } = await sb.from('page_content').select('*').eq('page', 'home').maybeSingle();
      if (loadError) {
        console.error('Could not load home page content:', loadError);
        window.showToast('Could not load home page content: ' + loadError.message);
        window.saveAll = () => window.showToast('Reload the page before saving.');
        return;
      }
      if (data?.content) {
        const c = data.content;
        document.getElementById('hero_eyebrow').value     = c.hero_eyebrow     || '';
        document.getElementById('hero_line1').value       = c.hero_line1       || c.hero_headline || '';
        document.getElementById('hero_line2').value       = c.hero_line2       || '';
        document.getElementById('hero_line3').value       = c.hero_line3       || '';
        document.getElementById('hero_sub').value         = c.hero_sub         || '';
        document.getElementById('hero_cta1_label').value  = c.hero_cta1_label  || '';
        document.getElementById('hero_cta1_url').value    = c.hero_cta1_url    || '';
        document.getElementById('hero_cta2_label').value  = c.hero_cta2_label  || '';
        document.getElementById('hero_cta2_url').value    = c.hero_cta2_url    || '';
        document.getElementById('brand_headline').value   = c.brand_headline   || '';
        document.getElementById('brand_sub').value        = c.brand_sub        || '';
        document.getElementById('brand_cta1').value       = c.brand_cta1       || '';
        document.getElementById('brand_cta1_url').value   = c.brand_cta1_url   || '';
        document.getElementById('brand_cta2').value       = c.brand_cta2       || '';
        document.getElementById('brand_cta2_url').value   = c.brand_cta2_url   || '';
        statsData = c.stats || [];
        renderStats();
      }

      window.saveAll = async () => {
        const content = {
          hero_eyebrow:   document.getElementById('hero_eyebrow').value,
          hero_line1:     document.getElementById('hero_line1').value,
          hero_line2:     document.getElementById('hero_line2').value,
          hero_line3:     document.getElementById('hero_line3').value,
          hero_sub:       document.getElementById('hero_sub').value,
          hero_cta1_label:document.getElementById('hero_cta1_label').value,
          hero_cta1_url:  document.getElementById('hero_cta1_url').value,
          hero_cta2_label:document.getElementById('hero_cta2_label').value,
          hero_cta2_url:  document.getElementById('hero_cta2_url').value,
          brand_headline: document.getElementById('brand_headline').value,
          brand_sub:      document.getElementById('brand_sub').value,
          brand_cta1:     document.getElementById('brand_cta1').value,
          brand_cta1_url: document.getElementById('brand_cta1_url').value,
          brand_cta2:     document.getElementById('brand_cta2').value,
          brand_cta2_url: document.getElementById('brand_cta2_url').value,
          stats: statsData,
        };
        const { error } = await sb.from('page_content').upsert({ page: 'home', content }, { onConflict: 'page' });
        if (error) {
          window.showToast('Could not save home page: ' + error.message);
          return;
        }
        window.showToast('Home page saved!');
      };
    })();

    function renderStats() {
      const wrapper = document.getElementById('stats-wrap');
      wrapper.replaceChildren();
      statsData.forEach((stat, index) => {
        const row = document.createElement('div');
        row.style.cssText = 'display:grid;grid-template-columns:1fr 1fr 1fr auto;gap:8px;margin-bottom:8px';
        [
          ['value', 'Value (e.g. 39)'],
          ['suffix', 'Suffix (e.g. +, M)'],
          ['label', 'Label'],
        ].forEach(([field, placeholder]) => {
          const input = document.createElement('input');
          input.className = 'form-input';
          input.value = stat[field] || '';
          input.placeholder = placeholder;
          input.addEventListener('input', () => { statsData[index][field] = input.value; });
          row.append(input);
        });
        const remove = document.createElement('button');
        remove.className = 'btn btn-danger btn-sm';
        remove.type = 'button';
        remove.textContent = 'Remove';
        remove.addEventListener('click', () => window.removeStat(index));
        row.append(remove);
        wrapper.append(row);
      });
    }

    window.addStat    = () => { statsData.push({ value: '', label: '' }); renderStats(); };
    window.removeStat = (i) => { statsData.splice(i, 1); renderStats(); };
    if (!window.saveAll) window.saveAll = () => window.showToast('Configure Supabase in .env first.');
  </script>

</DashboardLayout>
