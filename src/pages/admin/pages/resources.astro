---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
const sbUrl = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
const sbKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '';
---
<DashboardLayout title="Page — Resources" active="Resources">

  <div class="page-header">
    <div><div class="page-title">Resources</div><div class="page-sub">Manage downloadable guides, templates, and tools.</div></div>
    <button class="btn btn-primary" onclick="openModal()">+ Add Resource</button>
  </div>

  <div class="toolbar">
    <div class="search-bar" style="flex:1;max-width:320px">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input class="form-input" type="text" id="search" placeholder="Search resources…" oninput="filterRows()" />
    </div>
  </div>

  <div class="card">
    <div class="table-wrap">
      <table>
        <thead><tr><th>Title</th><th>Type</th><th>Category</th><th>Status</th><th>Actions</th></tr></thead>
        <tbody id="res-tbody"><tr><td colspan="5"><div class="empty-state"><p>Loading…</p></div></td></tr></tbody>
      </table>
    </div>
  </div>

  <div class="modal-overlay" id="modal">
    <div class="modal">
      <div class="modal-title" id="modal-title">Add Resource</div>
      <form id="res-form">
        <input type="hidden" id="edit-id" />
        <div class="form-group"><label class="form-label">Title *</label><input class="form-input" id="f-title" required /></div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
          <div class="form-group"><label class="form-label">Type</label>
            <select class="form-select" id="f-type"><option value="guide">Guide</option><option value="template">Template</option><option value="tool">Tool</option><option value="ebook">E-Book</option><option value="video">Video</option></select>
          </div>
          <div class="form-group"><label class="form-label">Category</label><input class="form-input" id="f-category" /></div>
        </div>
        <div class="form-group"><label class="form-label">Description</label><textarea class="form-textarea" id="f-desc"></textarea></div>
        <div class="form-group"><label class="form-label">Download / Link URL *</label><input class="form-input" id="f-url" required /></div>
        <div class="form-group"><label class="form-label">Thumbnail URL</label><input class="form-input" id="f-thumb" /></div>
        <div class="form-group"><label class="form-label">Status</label>
          <select class="form-select" id="f-status"><option value="draft">Draft</option><option value="published">Published</option></select>
        </div>
        <div class="modal-actions">
          <button type="button" class="btn btn-secondary" onclick="closeModal()">Cancel</button>
          <button type="submit" class="btn btn-primary">Save</button>
        </div>
      </form>
    </div>
  </div>

  <script define:vars={{ sbUrl, sbKey }}>
    (async () => {
      const { createClient } = await import('https://esm.sh/@supabase/supabase-js@2');
      const sb = createClient(sbUrl, sbKey);
      const TABLE = 'resources';
      let rows = [];

      async function load() {
        const { data } = await sb.from(TABLE).select('*').order('created_at', { ascending: false });
        rows = data || []; render(rows);
      }
      function render(data) {
        const tbody = document.getElementById('res-tbody');
        if (!data.length) { tbody.innerHTML = '<tr><td colspan="5"><div class="empty-state"><p>No resources yet.</p></div></td></tr>'; return; }
        tbody.innerHTML = data.map(r => `
          <tr>
            <td style="font-weight:600">${r.title}</td>
            <td><span class="badge badge-blue">${r.type || '—'}</span></td>
            <td style="color:var(--muted)">${r.category || '—'}</td>
            <td><span class="badge ${r.status === 'published' ? 'badge-green' : 'badge-yellow'}">${r.status}</span></td>
            <td style="display:flex;gap:6px">
              <button class="btn btn-secondary btn-sm" onclick="editRow('${r.id}')">Edit</button>
              <button class="btn btn-danger btn-sm" onclick="deleteRow('${r.id}')">Delete</button>
            </td>
          </tr>`).join('');
      }
      window.filterRows = () => { const q = document.getElementById('search').value.toLowerCase(); render(rows.filter(r => r.title.toLowerCase().includes(q))); };
      window.openModal = (id = null) => { document.getElementById('modal-title').textContent = id ? 'Edit Resource' : 'Add Resource'; document.getElementById('edit-id').value = id || ''; if (!id) document.getElementById('res-form').reset(); document.getElementById('modal').classList.add('open'); };
      window.editRow = (id) => {
        const r = rows.find(x => x.id === id); if (!r) return;
        document.getElementById('f-title').value    = r.title         || '';
        document.getElementById('f-type').value     = r.type          || '';
        document.getElementById('f-category').value = r.category      || '';
        document.getElementById('f-desc').value     = r.description   || '';
        document.getElementById('f-url').value      = r.url           || '';
        document.getElementById('f-thumb').value    = r.thumbnail_url || '';
        document.getElementById('f-status').value   = r.status        || 'draft';
        window.openModal(id);
      };
      window.deleteRow = async (id) => { if (!confirm('Delete?')) return; await sb.from(TABLE).delete().eq('id', id); window.showToast('Deleted.'); load(); };
      window.closeModal = () => document.getElementById('modal').classList.remove('open');
      document.getElementById('res-form').addEventListener('submit', async e => {
        e.preventDefault();
        const id = document.getElementById('edit-id').value;
        const payload = { title: document.getElementById('f-title').value, type: document.getElementById('f-type').value, category: document.getElementById('f-category').value, description: document.getElementById('f-desc').value, url: document.getElementById('f-url').value, thumbnail_url: document.getElementById('f-thumb').value, status: document.getElementById('f-status').value };
        if (id) { await sb.from(TABLE).update(payload).eq('id', id); window.showToast('Updated.'); }
        else    { await sb.from(TABLE).insert(payload); window.showToast('Added.'); }
        window.closeModal(); load();
      });
      load();
    })();
  </script>

</DashboardLayout>
