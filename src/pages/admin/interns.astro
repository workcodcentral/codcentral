---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
const sbUrl = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
const sbKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '';
---
<DashboardLayout title="Interns" active="Interns">

  <div class="page-header">
    <div><div class="page-title">Interns</div><div class="page-sub">Track intern applications and active cohorts.</div></div>
    <button class="btn btn-primary" onclick="openModal()">+ Add Intern</button>
  </div>

  <div class="toolbar">
    <div class="search-bar" style="flex:1;max-width:320px">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input class="form-input" type="text" id="search" placeholder="Search interns…" oninput="filterRows()" />
    </div>
    <select class="form-select" style="width:160px" id="status-filter" onchange="filterRows()">
      <option value="">All</option><option value="active">Active</option><option value="applicant">Applicant</option><option value="completed">Completed</option>
    </select>
  </div>

  <div class="card">
    <div class="table-wrap">
      <table>
        <thead><tr><th>Name</th><th>Email</th><th>Department</th><th>Start</th><th>End</th><th>Status</th><th>Actions</th></tr></thead>
        <tbody id="interns-tbody"><tr><td colspan="7"><div class="empty-state"><p>Loading…</p></div></td></tr></tbody>
      </table>
    </div>
  </div>

  <div class="modal-overlay" id="modal">
    <div class="modal">
      <div class="modal-title" id="modal-title">Add Intern</div>
      <form id="interns-form">
        <input type="hidden" id="edit-id" />
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
          <div class="form-group"><label class="form-label">Full Name *</label><input class="form-input" id="f-name" required /></div>
          <div class="form-group"><label class="form-label">Email *</label><input class="form-input" type="email" id="f-email" required /></div>
          <div class="form-group"><label class="form-label">Phone</label><input class="form-input" id="f-phone" /></div>
          <div class="form-group"><label class="form-label">Department</label>
            <select class="form-select" id="f-dept"><option value="">Select…</option><option value="Marketing">Marketing</option><option value="Technology">Technology</option><option value="Design">Design</option><option value="Operations">Operations</option></select>
          </div>
          <div class="form-group"><label class="form-label">Start Date</label><input class="form-input" type="date" id="f-start" /></div>
          <div class="form-group"><label class="form-label">End Date</label><input class="form-input" type="date" id="f-end" /></div>
        </div>
        <div class="form-group"><label class="form-label">University / College</label><input class="form-input" id="f-school" /></div>
        <div class="form-group"><label class="form-label">Notes</label><textarea class="form-textarea" id="f-notes"></textarea></div>
        <div class="form-group"><label class="form-label">Status</label>
          <select class="form-select" id="f-status"><option value="applicant">Applicant</option><option value="active">Active</option><option value="completed">Completed</option></select>
        </div>
        <div class="modal-actions">
          <button type="button" class="btn btn-secondary" onclick="closeModal()">Cancel</button>
          <button type="submit" class="btn btn-primary">Save</button>
        </div>
      </form>
    </div>
  </div>

  <script define:vars={{ sbUrl, sbKey }}>
    (async () => {
      const { createClient } = await import('https://esm.sh/@supabase/supabase-js@2');
      const sb = createClient(sbUrl, sbKey);
      const TABLE = 'interns';
      let rows = [];

      async function load() {
        const { data } = await sb.from(TABLE).select('*').order('created_at', { ascending: false });
        rows = data || []; render(rows);
      }
      function render(data) {
        const tbody = document.getElementById('interns-tbody');
        if (!data.length) { tbody.innerHTML = '<tr><td colspan="7"><div class="empty-state"><p>No interns yet.</p></div></td></tr>'; return; }
        tbody.innerHTML = data.map(r => `
          <tr>
            <td style="font-weight:600">${r.name}</td>
            <td style="color:var(--muted)">${r.email}</td>
            <td><span class="badge badge-blue">${r.department || '—'}</span></td>
            <td style="color:var(--muted);white-space:nowrap">${r.start_date || '—'}</td>
            <td style="color:var(--muted);white-space:nowrap">${r.end_date || '—'}</td>
            <td><span class="badge ${r.status === 'active' ? 'badge-green' : r.status === 'completed' ? 'badge-gray' : 'badge-yellow'}">${r.status}</span></td>
            <td style="display:flex;gap:6px">
              <button class="btn btn-secondary btn-sm" onclick="editRow('${r.id}')">Edit</button>
              <button class="btn btn-danger btn-sm" onclick="deleteRow('${r.id}')">Delete</button>
            </td>
          </tr>`).join('');
      }
      window.filterRows = () => { const q = document.getElementById('search').value.toLowerCase(); const s = document.getElementById('status-filter').value; render(rows.filter(r => r.name.toLowerCase().includes(q) && (s ? r.status === s : true))); };
      window.openModal = (id = null) => { document.getElementById('modal-title').textContent = id ? 'Edit Intern' : 'Add Intern'; document.getElementById('edit-id').value = id || ''; if (!id) document.getElementById('interns-form').reset(); document.getElementById('modal').classList.add('open'); };
      window.editRow = (id) => {
        const r = rows.find(x => x.id === id); if (!r) return;
        document.getElementById('f-name').value   = r.name       || '';
        document.getElementById('f-email').value  = r.email      || '';
        document.getElementById('f-phone').value  = r.phone      || '';
        document.getElementById('f-dept').value   = r.department || '';
        document.getElementById('f-start').value  = r.start_date || '';
        document.getElementById('f-end').value    = r.end_date   || '';
        document.getElementById('f-school').value = r.school     || '';
        document.getElementById('f-notes').value  = r.notes      || '';
        document.getElementById('f-status').value = r.status     || 'applicant';
        window.openModal(id);
      };
      window.deleteRow = async (id) => { if (!confirm('Remove intern?')) return; await sb.from(TABLE).delete().eq('id', id); window.showToast('Removed.'); load(); };
      window.closeModal = () => document.getElementById('modal').classList.remove('open');
      document.getElementById('interns-form').addEventListener('submit', async e => {
        e.preventDefault();
        const id = document.getElementById('edit-id').value;
        const payload = { name: document.getElementById('f-name').value, email: document.getElementById('f-email').value, phone: document.getElementById('f-phone').value, department: document.getElementById('f-dept').value, start_date: document.getElementById('f-start').value || null, end_date: document.getElementById('f-end').value || null, school: document.getElementById('f-school').value, notes: document.getElementById('f-notes').value, status: document.getElementById('f-status').value };
        if (id) { await sb.from(TABLE).update(payload).eq('id', id); window.showToast('Updated.'); }
        else    { await sb.from(TABLE).insert(payload); window.showToast('Added.'); }
        window.closeModal(); load();
      });
      load();
    })();
  </script>

</DashboardLayout>
