---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
const sbUrl = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
const sbKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '';
const isConfigured = sbUrl && sbUrl !== 'your_supabase_project_url';
---
<DashboardLayout title="Settings" active="Settings">

  <div class="page-header">
    <div><div class="page-title">Settings</div><div class="page-sub">Global site configuration and preferences.</div></div>
    <button class="btn btn-primary" onclick="saveAll()">Save Changes</button>
  </div>

  <div style="display:grid;gap:16px">

    <!-- Site Identity -->
    <div class="card card-pad">
      <div style="font-size:14px;font-weight:700;margin-bottom:16px;color:var(--text)">Site Identity</div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
        <div class="form-group"><label class="form-label">Site Name</label><input class="form-input" id="site_name" /></div>
        <div class="form-group"><label class="form-label">Tagline</label><input class="form-input" id="site_tagline" /></div>
        <div class="form-group"><label class="form-label">Logo URL</label><input class="form-input" id="logo_url" /></div>
        <div class="form-group"><label class="form-label">Favicon URL</label><input class="form-input" id="favicon_url" /></div>
      </div>
      <div class="form-group"><label class="form-label">Meta Description</label><textarea class="form-textarea" id="meta_description"></textarea></div>
    </div>

    <!-- Contact -->
    <div class="card card-pad">
      <div style="font-size:14px;font-weight:700;margin-bottom:16px;color:var(--text)">Contact Information</div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
        <div class="form-group"><label class="form-label">Email</label><input class="form-input" type="email" id="contact_email" /></div>
        <div class="form-group"><label class="form-label">Phone</label><input class="form-input" id="contact_phone" /></div>
        <div class="form-group"><label class="form-label">WhatsApp Number</label><input class="form-input" id="whatsapp_number" placeholder="+256754138667" /></div>
        <div class="form-group"><label class="form-label">Location</label><input class="form-input" id="location" /></div>
      </div>
    </div>

    <!-- Social -->
    <div class="card card-pad">
      <div style="font-size:14px;font-weight:700;margin-bottom:16px;color:var(--text)">Social Media Links</div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
        <div class="form-group"><label class="form-label">LinkedIn</label><input class="form-input" id="social_linkedin" /></div>
        <div class="form-group"><label class="form-label">Twitter / X</label><input class="form-input" id="social_twitter" /></div>
        <div class="form-group"><label class="form-label">Instagram</label><input class="form-input" id="social_instagram" /></div>
        <div class="form-group"><label class="form-label">Facebook</label><input class="form-input" id="social_facebook" /></div>
        <div class="form-group"><label class="form-label">YouTube</label><input class="form-input" id="social_youtube" /></div>
        <div class="form-group"><label class="form-label">TikTok</label><input class="form-input" id="social_tiktok" /></div>
      </div>
    </div>

    <!-- Toggles -->
    <div class="card card-pad">
      <div style="font-size:14px;font-weight:700;margin-bottom:16px;color:var(--text)">Feature Toggles</div>
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:12px">
        {['whatsapp_widget','newsletter_banner','cookie_banner','maintenance_mode','show_shop','show_insights'].map(key => (
          <label style="display:flex;align-items:center;gap:10px;font-size:13px;cursor:pointer;padding:10px;border:1px solid var(--border);border-radius:6px;color:var(--text)">
            <input type="checkbox" id={`ft_${key}`} style="width:16px;height:16px;cursor:pointer;accent-color:var(--red)" />
            {key.replaceAll('_', ' ').replace(/\b\w/g, c => c.toUpperCase())}
          </label>
        ))}
      </div>
    </div>

    <!-- Supabase status -->
    <div class="card card-pad" style={`border-left:3px solid ${isConfigured ? '#4ade80' : 'var(--red)'}`}>
      <div style="font-size:14px;font-weight:700;margin-bottom:4px;color:var(--text)">Supabase Connection</div>
      <div style="font-size:12px;color:var(--muted);margin-bottom:14px">These values come from your <code style="background:var(--bg3);padding:2px 6px;border-radius:4px">.env</code> file.</div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px">
        <div class="form-group">
          <label class="form-label">Project URL</label>
          <input class="form-input" value={sbUrl || 'Not set'} readonly style="opacity:0.5;cursor:not-allowed" />
        </div>
        <div class="form-group">
          <label class="form-label">Anon Key (masked)</label>
          <input class="form-input" value={sbKey ? sbKey.slice(0, 16) + '…' : 'Not set'} readonly style="opacity:0.5;cursor:not-allowed" />
        </div>
      </div>
      <span class={`badge ${isConfigured ? 'badge-green' : 'badge-red'}`}>
        {isConfigured ? '● Connected' : '✕ Not configured — update .env'}
      </span>
    </div>

  </div>

  <script define:vars={{ sbUrl, sbKey }}>
    const FIELDS   = ['site_name','site_tagline','logo_url','favicon_url','meta_description','contact_email','contact_phone','whatsapp_number','location','social_linkedin','social_twitter','social_instagram','social_facebook','social_youtube','social_tiktok'];
    const TOGGLES  = ['whatsapp_widget','newsletter_banner','cookie_banner','maintenance_mode','show_shop','show_insights'];

    (async () => {
      if (!sbUrl || sbUrl === 'your_supabase_project_url') return;
      const { createClient } = await import('https://esm.sh/@supabase/supabase-js@2');
      const sb = createClient(sbUrl, sbKey);

      const { data } = await sb.from('settings').select('*').eq('key', 'global').maybeSingle();
      if (data?.value) {
        const c = data.value;
        FIELDS.forEach(f  => { const el = document.getElementById(f);       if (el) el.value   = c[f] || ''; });
        TOGGLES.forEach(f => { const el = document.getElementById('ft_'+f); if (el) el.checked = !!c[f]; });
      }

      window.saveAll = async () => {
        const value = {};
        FIELDS.forEach(f  => { const el = document.getElementById(f);       if (el) value[f] = el.value; });
        TOGGLES.forEach(f => { const el = document.getElementById('ft_'+f); if (el) value[f] = el.checked; });
        await sb.from('settings').upsert({ key: 'global', value }, { onConflict: 'key' });
        window.showToast('Settings saved!');
      };
    })();

    // Define saveAll as a no-op in case Supabase isn't configured yet
    if (!window.saveAll) {
      window.saveAll = () => window.showToast('Configure Supabase in .env first.');
    }
  </script>

</DashboardLayout>
