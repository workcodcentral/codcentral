---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
const sbUrl = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
const sbKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '';
---
<DashboardLayout title="Newsletters" active="Newsletters">

  <div class="page-header">
    <div><div class="page-title">Newsletters</div><div class="page-sub">Compose and track newsletter campaigns.</div></div>
    <button class="btn btn-primary" onclick="openModal()">+ New Newsletter</button>
  </div>

  <div class="toolbar">
    <div class="search-bar" style="flex:1;max-width:320px">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input class="form-input" type="text" id="search" placeholder="Search…" oninput="filterRows()" />
    </div>
  </div>

  <div class="card">
    <div class="table-wrap">
      <table>
        <thead><tr><th>Subject</th><th>Recipients</th><th>Status</th><th>Sent At</th><th>Actions</th></tr></thead>
        <tbody id="nl-tbody"><tr><td colspan="5"><div class="empty-state"><p>Loading…</p></div></td></tr></tbody>
      </table>
    </div>
  </div>

  <div class="modal-overlay" id="modal">
    <div class="modal">
      <div class="modal-title" id="modal-title">New Newsletter</div>
      <form id="nl-form">
        <input type="hidden" id="edit-id" />
        <div class="form-group"><label class="form-label">Subject *</label><input class="form-input" id="f-subject" required /></div>
        <div class="form-group"><label class="form-label">Preview Text</label><input class="form-input" id="f-preview" /></div>
        <div class="form-group"><label class="form-label">Body</label><textarea class="form-textarea" id="f-body" style="min-height:180px"></textarea></div>
        <div class="form-group"><label class="form-label">Status</label>
          <select class="form-select" id="f-status">
            <option value="draft">Draft</option><option value="scheduled">Scheduled</option><option value="sent">Sent</option>
          </select>
        </div>
        <div class="modal-actions">
          <button type="button" class="btn btn-secondary" onclick="closeModal()">Cancel</button>
          <button type="submit" class="btn btn-primary">Save</button>
        </div>
      </form>
    </div>
  </div>

  <script define:vars={{ sbUrl, sbKey }}>
    (async () => {
      const { createClient } = await import('https://esm.sh/@supabase/supabase-js@2');
      const sb = createClient(sbUrl, sbKey);
      const TABLE = 'newsletters';
      let rows = [];

      async function load() {
        const { data } = await sb.from(TABLE).select('*').order('created_at', { ascending: false });
        rows = data || []; render(rows);
      }
      function render(data) {
        const tbody = document.getElementById('nl-tbody');
        if (!data.length) { tbody.innerHTML = '<tr><td colspan="5"><div class="empty-state"><p>No newsletters yet.</p></div></td></tr>'; return; }
        tbody.innerHTML = data.map(r => `
          <tr>
            <td style="font-weight:600">${r.subject}</td>
            <td style="color:var(--muted)">${r.recipient_count ?? 0}</td>
            <td><span class="badge ${r.status === 'sent' ? 'badge-green' : r.status === 'scheduled' ? 'badge-blue' : 'badge-yellow'}">${r.status}</span></td>
            <td style="color:var(--muted)">${r.sent_at ? new Date(r.sent_at).toLocaleString() : '—'}</td>
            <td style="display:flex;gap:6px">
              <button class="btn btn-secondary btn-sm" onclick="editRow('${r.id}')">Edit</button>
              <button class="btn btn-danger btn-sm" onclick="deleteRow('${r.id}')">Delete</button>
            </td>
          </tr>`).join('');
      }
      window.filterRows = () => { const q = document.getElementById('search').value.toLowerCase(); render(rows.filter(r => r.subject.toLowerCase().includes(q))); };
      window.openModal = (id = null) => { document.getElementById('modal-title').textContent = id ? 'Edit Newsletter' : 'New Newsletter'; document.getElementById('edit-id').value = id || ''; if (!id) document.getElementById('nl-form').reset(); document.getElementById('modal').classList.add('open'); };
      window.editRow = (id) => { const r = rows.find(x => x.id === id); if (!r) return; document.getElementById('f-subject').value = r.subject || ''; document.getElementById('f-preview').value = r.preview_text || ''; document.getElementById('f-body').value = r.body || ''; document.getElementById('f-status').value = r.status || 'draft'; window.openModal(id); };
      window.deleteRow = async (id) => { if (!confirm('Delete?')) return; await sb.from(TABLE).delete().eq('id', id); window.showToast('Deleted.'); load(); };
      window.closeModal = () => document.getElementById('modal').classList.remove('open');
      document.getElementById('nl-form').addEventListener('submit', async e => {
        e.preventDefault();
        const id = document.getElementById('edit-id').value;
        const payload = { subject: document.getElementById('f-subject').value, preview_text: document.getElementById('f-preview').value, body: document.getElementById('f-body').value, status: document.getElementById('f-status').value };
        if (id) { await sb.from(TABLE).update(payload).eq('id', id); window.showToast('Updated.'); }
        else    { await sb.from(TABLE).insert(payload); window.showToast('Created.'); }
        window.closeModal(); load();
      });
      load();
    })();
  </script>

</DashboardLayout>
