---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
const sbUrl = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
const sbKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '';
---
<DashboardLayout title="System Health" active="System Health">

  <div class="page-header">
    <div><div class="page-title">System Health</div><div class="page-sub">Live status of database tables and connections.</div></div>
    <button class="btn btn-secondary" onclick="runCheck()">↻ Refresh</button>
  </div>

  <div class="stat-grid">
    <div class="stat-card"><div class="stat-label">Supabase</div><div id="h-db" class="stat-value" style="font-size:16px;margin-top:4px">Checking…</div></div>
    <div class="stat-card"><div class="stat-label">Total Records</div><div id="h-records" class="stat-value">—</div><div class="stat-sub">Across all tables</div></div>
    <div class="stat-card"><div class="stat-label">Tables</div><div id="h-tables" class="stat-value">—</div><div class="stat-sub">Registered</div></div>
    <div class="stat-card"><div class="stat-label">Last Check</div><div id="h-time" class="stat-value" style="font-size:14px;margin-top:4px">—</div></div>
  </div>

  <div class="card card-pad">
    <div style="font-size:14px;font-weight:700;margin-bottom:14px;color:var(--text)">Table Status</div>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Table</th><th>Row Count</th><th>Status</th></tr></thead>
        <tbody id="tables-tbody"><tr><td colspan="3"><div class="empty-state"><p>Running check…</p></div></td></tr></tbody>
      </table>
    </div>
  </div>

  <script define:vars={{ sbUrl, sbKey }}>
    const TABLES = ['news_articles','blogs','newsletters','photos','videos','events','interns','users','resources','shop_products','page_content','settings'];

    window.runCheck = async () => {
      document.getElementById('h-db').innerHTML = 'Checking…';
      document.getElementById('h-time').textContent = new Date().toLocaleTimeString();

      if (!sbUrl || sbUrl === 'your_supabase_project_url') {
        document.getElementById('h-db').innerHTML = '<span class="badge badge-red">Not configured</span>';
        document.getElementById('tables-tbody').innerHTML = '<tr><td colspan="3"><div class="empty-state"><p>Add Supabase credentials to .env to run health checks.</p></div></td></tr>';
        return;
      }

      const { createClient } = await import('https://esm.sh/@supabase/supabase-js@2');
      const sb = createClient(sbUrl, sbKey);
      let total = 0;
      const tableRows = [];

      for (const t of TABLES) {
        const { count, error } = await sb.from(t).select('*', { count: 'exact', head: true });
        const ok = !error;
        if (ok) total += count || 0;
        tableRows.push({ table: t, count: ok ? (count ?? 0) : '—', ok });
      }

      document.getElementById('h-db').innerHTML = '<span class="badge badge-green">● Connected</span>';
      document.getElementById('h-records').textContent = total.toLocaleString();
      document.getElementById('h-tables').textContent = TABLES.length;
      document.getElementById('tables-tbody').innerHTML = tableRows.map(r => `
        <tr>
          <td style="font-family:monospace;font-size:12px;color:var(--muted)">${r.table}</td>
          <td style="font-weight:600">${typeof r.count === 'number' ? r.count.toLocaleString() : r.count}</td>
          <td><span class="badge ${r.ok ? 'badge-green' : 'badge-red'}">${r.ok ? 'OK' : 'Error'}</span></td>
        </tr>`).join('');
    };

    runCheck();
  </script>

</DashboardLayout>
